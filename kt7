<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>123123</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        section {
            padding: 100px 0;
            text-align: center;
            min-height: 100vh;
        }
        header {
            background: #00A3E0;
            color: white;
            padding: 30px 0;
            text-align: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }
        header h1 {
            margin: 0;
            font-size: 36px;
        }
        .banner {
            background: #FF5733;
            color: white;
            padding: 50px 0;
            text-align: center;
            font-size: 28px;
        }
        .features {
            display: flex;
            justify-content: space-around;
            gap: 20px;
            margin-top: 50px;
        }
        .feature {
            background: #f5f5f5;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            width: 25%;
            transition: transform 0.3s ease;
        }
        .feature:hover {
            transform: scale(1.05);
        }
        .cta {
            background: #28a745;
            color: white;
            padding: 30px 0;
            font-size: 24px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }
        .cta:hover {
            background: #218838;
        }
        .footer {
            background: #333;
            color: white;
            padding: 20px 0;
        }
        .scroll-button {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #00A3E0;
            color: white;
            padding: 15px;
            border-radius: 50%;
            cursor: pointer;
            display: none;
            font-size: 20px;
            transition: background-color 0.3s;
        }
        .scroll-button:hover {
            background-color: #007bb5;
        }
        .fadeIn {
            animation: fadeIn 1.5s ease-in-out forwards;
        }
        @keyframes fadeIn {
            0% { opacity: 0; }
            100% { opacity: 1; }
        }
    </style>
</head>
<body>

    <header>
        <h1>Добро пожаловать на наш сайт!</h1>
    </header>

    <section class="banner fadeIn">
        <h2>Это наш баннер</h2>
        <p>Краткое описание предложения или продукта</p>
    </section>

    <section>
        <h2>Наши особенности</h2>
        <div class="features">
            <div class="feature fadeIn">
                <h3>Особенность 1</h3>
                <p>Описание особенностей продукта.</p>
            </div>
            <div class="feature fadeIn">
                <h3>Особенность 2</h3>
                <p>Описание особенностей продукта.</p>
            </div>
            <div class="feature fadeIn">
                <h3>Особенность 3</h3>
                <p>Описание особенностей продукта.</p>
            </div>
        </div>
    </section>

    <section class="cta fadeIn">
        <h2>Не упустите свой шанс!</h2>
        <p>Присоединяйтесь к нам уже сегодня.</p>
    </section>

    <section>
        <h2>Наши услуги</h2>
        <div class="features">
            <div class="feature fadeIn">
                <h3>Услуга 1</h3>
                <p>Описание услуги 1.</p>
            </div>
            <div class="feature fadeIn">
                <h3>Услуга 2</h3>
                <p>Описание услуги 2.</p>
            </div>
            <div class="feature fadeIn">
                <h3>Услуга 3</h3>
                <p>Описание услуги 3.</p>
            </div>
        </div>
    </section>

    <section class="footer">
        <p>&copy; 2025 Наш сайт. Все права защищены.</p>
    </section>

    <button class="scroll-button" id="scrollBtn">&#8595;</button>

    <script>
        window.onscroll = function() {
            var button = document.getElementById("scrollBtn");
            if (document.body.scrollTop > 300 || document.documentElement.scrollTop > 300) {
                button.style.display = "block";
            } else {
                button.style.display = "none";
            }
        };

        document.getElementById("scrollBtn").addEventListener("click", function() {
            window.scrollBy(0, window.innerHeight);
        });
    </script>
</body>
</html>
